module bibble.internal.file;

const uint READ = 0x1;
const uint WRITE = 0x2;
const uint APPEND = 0x4;
const uint CREATE = 0x8;
const uint TRUNCATE = 0x10;
const uint EXCLUSIVE = 0x20;
const uint TEMPORARY = 0x40;
const uint RANDOM_ACCESS = 0x80;
const uint SEQUENTIAL = 0x100;
const uint DIRECT = 0x200;
const uint SYNC = 0x400;
const uint DELETE_ON_CLOSE = 0x800;

native handle stdin();
native handle stdout();
native handle stderr();

native handle open(string path, uint flags);
native void close(handle file);

native void write_byte(handle file, byte b);

void write_string(handle file, string s) {
    ulong len = s.length;
    for (ulong i = 0; i < len; i += 1) {
        write_byte(file, s[i]);
    }
}

native byte read_byte(handle file);