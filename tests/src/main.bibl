module main;

import bibble.file;
import bibble.init;
import bibble.runtime;

int main() {
    init::init();

    handle out = file::stdout();

    runtime::set_property("test", "hey world\n");

    string value = runtime::get_property("test");

    file::write_string(out, value);

    runtime::exit(67);

    return 0;
}