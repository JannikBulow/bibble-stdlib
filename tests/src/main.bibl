module main;

import bibble.internal.file;

import bibble.init;

int main() {
    init::init();

    handle out = file::stdout();

    byte[] text = new byte[6];
    text[0] = 'H';
    text[1] = 'e';
    text[2] = 'l';
    text[3] = 'l';
    text[4] = 'o';
    text[5] = '\n';

    file::write_bytes(out, text);

    return 0;
}